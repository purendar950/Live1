<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/float_card_bg"
    android:padding="14dp"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:elevation="20dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView android:id="@+id/tvChapter"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="📚 Ch.1"
            android:textSize="11sp" android:textStyle="bold" android:textColor="#A78BFA"
            android:background="@drawable/badge_bg"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="3dp" android:paddingBottom="3dp"/>

        <TextView android:id="@+id/tvTimer"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⏱ 15" android:textSize="13sp"
            android:textStyle="bold" android:textColor="#A78BFA"
            android:layout_marginStart="8dp"/>

        <ImageButton android:id="@+id/btnClose"
            android:layout_width="32dp" android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="@android:color/transparent"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <TextView android:id="@+id/tvQNum"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Q1 of 100" android:textSize="11sp"
        android:textColor="#8899BB" android:layout_marginBottom="5dp"/>

    <TextView android:id="@+id/tvQ"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Loading..." android:textSize="15sp"
        android:textStyle="bold" android:textColor="#F0F4FF"
        android:lineSpacingMultiplier="1.4" android:layout_marginBottom="4dp"/>

    <TextView android:id="@+id/tvHi"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#8899BB"
        android:lineSpacingMultiplier="1.4" android:visibility="gone"
        android:layout_marginBottom="10dp"/>

    <LinearLayout android:id="@+id/optContainer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginBottom="6dp"/>

    <TextView android:id="@+id/tvExp"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#8899BB"
        android:lineSpacingMultiplier="1.4" android:visibility="gone"
        android:background="@drawable/exp_bg" android:padding="10dp"/>

</LinearLayout>
